# Copy to .env and fill in. NEVER commit .env — credentials live in the ClickUp
# "QA Testing accounts" page, not in this repo.

# Frontend site of the brand under test (used by the browser stage and to derive hosts)
SITE_URL=https://betjordan.stage24.net

# Derived hosts — override only if the <prefix>.<base-domain> convention doesn't apply
# CMS_URL=https://yweave.stage24.net
# PS_URL=https://ps.stage24.net
# MW_URL=https://back.stage24.net

# What to test — the test's unit is a brand configuration (brand+region).
# Preferred: the portal brand-configuration id (a wrong id prints the list of
# available configurations with their names).
BRAND_CONFIG_ID=
# Region by name — leave empty to test the brand's any-region catalog. The
# config's region is not stored in the CMS, so it cannot be derived from
# BRAND_CONFIG_ID; set it to match the configuration you're testing.
REGION=

# Alternative: brand by NAME as shown in the CMS (same name on every
# environment; a wrong name prints the available brands).
BRAND=

# Advanced: explicit ids override every resolution above (normally not needed)
# CMS_BRAND_ID=
# PORTAL_BRAND_ID=
# CMS_REGION_ID=

# Countries are OPTIONAL. Leave both empty for the default validation mode:
# the CMS then omits the game/producer country blacklists and the sweep covers
# the FULL curated catalog of the brand+region (the superset any player could
# see). Set both to reproduce exactly what one market sees instead.
PLAYER_COUNTRY=
IP_COUNTRY=

LOCALE=en

# Session: either a ready sessionKey, or test-user credentials for auto-login
# (and automatic re-login when the session expires mid-run). Demo mode is not
# an option: disabled in the client and not every game supports it.
SESSION_KEY=
TEST_USER=
TEST_PASSWORD=

# Tuning
CONCURRENCY=5
REQUEST_TIMEOUT_MS=20000
# Limit how many games run through stage 2 (empty = whole catalog)
MAX_GAMES=
